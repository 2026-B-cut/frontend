{
  "expo": {
    "name": "찌그까",
    "slug": "B-Cut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/favicon.png",
    "scheme": "bcut",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bcut.app"
    },
    "android": {
      "package": "com.bcut.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "kakao632bc2c26ffd61c3edfcdcdcc4169436",
              "host": "kakaolink"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "jjigeukka.kro.kr"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "B-Cut에서 미션 인증 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "B-Cut에서 미션 장소와의 거리를 단말기 안에서 확인하기 위해 현재 위치 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "B-Cut에서 프로필 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다.",
          "photosPermission": "B-Cut에서 프로필 사진을 선택하기 위해 사진 접근 권한이 필요합니다."
        }
      ],
      "expo-secure-store",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "632bc2c26ffd61c3edfcdcdcc4169436"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "./plugins/with-kakao-share-sdk"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e389d9b-c577-49a1-99bc-e9139d5ba2d4"
      }
    },
    "owner": "junyi04"
  }
}
